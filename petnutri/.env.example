# Copy this file to ".env" for local development and fill in your own key.
# NEVER commit your real ".env" file or real API key to GitHub.
#
# For Streamlit Cloud deployment, do NOT use this file - instead set these
# same two values as TOML secrets in the app's "Manage app" -> "Secrets" panel:
#
#   OPENROUTER_API_KEY = "your_openrouter_key_here"
#   OPENROUTER_MODEL = "openai/gpt-4o-mini"

OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_MODEL=openai/gpt-4o-mini
